[tasks]
prove
bug
cover
pass
pass_noenv
wait
wait_bug

[options]
prove:      mode prove
bug:        mode bmc
cover:      mode cover
pass:       mode prove
pass_noenv: mode prove
wait:       mode prove
wait_bug:   mode bmc
depth 10

[engines]
smtbmc

[script]
prove:      read_verilog -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
bug:        read_verilog -D BUG -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
cover:      read_verilog -D WAIT -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
pass:       read_verilog -D PASS -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
pass_noenv: read_verilog -D PASS -D NO_ENV -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
wait:       read_verilog -D WAIT -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
wait_bug:   read_verilog -D WAIT_BUG -formal -sv chk_valid_ready.sv rs_slice.sv rs_formal_top.sv
prep -top rs_formal_top

[files]
../../chk_lib/common/chk_bitops.svh
../../chk_lib/common/chk_past.svh
../../chk_lib/common/chk_reset.svh
../../chk_lib/common/chk_role.svh
../../chk_lib/formal/chk_macros.svh
../../chk_lib/checkers/chk_valid_ready.sv
rs_slice.sv
rs_formal_top.sv
